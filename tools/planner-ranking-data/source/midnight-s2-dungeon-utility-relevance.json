  "scoreDefinition": {
    "0": "No meaningful supported use in the current Season 2 version.",
    "1": "Niche, route-dependent, recovery-only, or minor value.",
    "2": "Useful and repeatedly relevant, or very valuable in one meaningful section.",
    "3": "Core, frequent, or critical utility for this dungeon."
  },
  "scoringUsage": {
    "formula": "contextualUtility = baseCapabilityValue * (dungeonRelevance / 3) * availabilityFactor * marginalCoverageFactor",
    "rule": "Only capabilities present in this score matrix are dungeon-modulated. Canonical non-contextual capabilities retain factor 1.0.",
    "interruptRule": "INTERRUPT is included as an explicit reference score even though the canonical catalog treats it as universally valuable.",
    "zeroRule": "A score of 0 must not delete the ability from the catalog; it only contributes zero dungeon-context value.",
    "redundancyRule": "Apply the canonical catalog stacking policy after the dungeon factor; do not sum duplicate coverage at full value.",
    "recoveryRule": "Utilities whose evidence is primarily recoveryOnly should normally cap at score 1 unless separate unavoidable/core use exists."
  },
