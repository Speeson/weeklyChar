{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KeystoneClient",
  "mainBinaryName": "KeystoneClient",
  "version": "0.5.0",
  "identifier": "dev.esgarpe.keystoneclient",
  "build": {
    "beforeDevCommand": "npm run sidecar:build && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run sidecar:build && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "KeystoneClient",
        "width": 1672,
        "height": 941,
        "minWidth": 940,
        "minHeight": 529,
        "resizable": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": false,
    "externalBin": [
      "binaries/keystone-client-core"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Speeson",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM2ODc2OUZFNjA1NkEwQzAKUldUQW9GWmcvbW1IeHRXeDhqRUIwRG5tRXNpMTY0WjZYbmw0WCtwTnhNcjlKeUtPOXNQMXVQZUwK",
      "endpoints": [
        "https://github.com/Speeson/weeklyChar/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
