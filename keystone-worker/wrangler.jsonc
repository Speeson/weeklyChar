{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "keystone-sync-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-25",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "keystone-sync",
      "database_id": "replace-with-cloudflare-d1-database-id"
    }
  ]
}
