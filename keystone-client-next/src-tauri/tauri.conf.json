{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KeystoneClient Next",
  "version": "0.1.0",
  "identifier": "dev.esgarpe.keystoneclient.next",
  "build": {
    "beforeDevCommand": "npm run sidecar:build && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run sidecar:build && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "KeystoneClient Next",
        "width": 1672,
        "height": 941,
        "minWidth": 940,
        "minHeight": 529,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/keystone-client-core"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
